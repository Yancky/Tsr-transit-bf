# ==============================================================================
# TSR TRANSIT / TSR APP v1.0 — Variables d'Environnement
# ==============================================================================

# Clé API Google Gemini (injectée automatiquement par AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL de base de l'application (Cloud Run / Vercel / Déploiement)
APP_URL="MY_APP_URL"

# ==============================================================================
# CONFIGURATION OFFICIELLE LIGDICASH PAYLINK API (Burkina Faso)
# Documentation : https://developers.ligdicash.com / https://app.ligdicash.com
# ==============================================================================

# Clé API du projet LigdiCash (transmise dans le header HTTP 'Apikey')
LIGDICASH_API_KEY="VOTRE_CLE_API_PROJET_LIGDICASH"

# Token d'authentification marchand (transmis dans le header 'Authorization: Bearer {TOKEN}')
LIGDICASH_API_TOKEN="VOTRE_TOKEN_MARCHAND_LIGDICASH"

# Environnement d'exécution : 'live' pour production réelle, 'sandbox' ou 'test' pour validation
LIGDICASH_ENV="sandbox"

# URL racine de l'API LigdiCash (défaut : https://app.ligdicash.com)
LIGDICASH_BASE_URL="https://app.ligdicash.com"

# URL publique de notification webhook (généralement ${APP_URL}/api/payments/ligdicash/webhook)
LIGDICASH_CALLBACK_URL="https://mon-domaine.bf/api/payments/ligdicash/webhook"

# URL de redirection après validation sur le portail LigdiCash
LIGDICASH_RETURN_URL="https://mon-domaine.bf/api/payments/ligdicash/return"

# URL de redirection en cas d'annulation sur le portail LigdiCash
LIGDICASH_CANCEL_URL="https://mon-domaine.bf/api/payments/ligdicash/cancel"
